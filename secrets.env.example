# ⚠️ 本文件是模板。复制成 secrets.env 后填入真实值，并 chmod 600。
# secrets.env 已被 .gitignore 排除，不要提交到 Git。
#
# 用法：cp secrets.env.example secrets.env && chmod 600 secrets.env

# ── 必填 ────────────────────────────────────────────────────────────────
GAOJI_USERNAME=your-account-here
GAOJI_PASSWORD=your-password-here
GAOJI_PROVIDER_ID=your-provider-id-here
GAOJI_USER_ID=          # 可留空：登录后自动探测

# ── 选填（下面为默认值，一般不用改）──────────────────────────────────────
# GAOJI_BASE_URL=https://helpdesk.example.com
# GAOJI_POLL_SECONDS=5
# GAOJI_WINDOW_START=07:30
# GAOJI_WINDOW_END=22:00
# GAOJI_LOG_FILE=/var/log/gaoji-helpdesk/accept.log
# GAOJI_AUTO_REPLY=您好，请描述一下具体情况并附上截图，我们尽快为您处理；如需远程协助，请提供远程工具识别码和验证码。感谢您的配合！
